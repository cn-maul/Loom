# Build outputs
# internal/frontend/dist is the copy build.ps1/bat/sh makes of web/dist for
# go:embed, so it is generated too and must not be committed.
*.exe
/relationship
web/dist/
internal/frontend/dist/
data/

# Secrets / credentials
config.yaml

# Node modules
node_modules/

# Local run artifacts: server logs and the scratch files the build/verify
# commands drop in the project root. They are regenerated every run and must
# never reach the repository. Project docs are Markdown, so any .txt at the
# root is scratch output by definition.
*.log
/*.txt
smoke_tmp/

# Per-session agent data (memory logs, skill scratch space)
.workbuddy/

# IDE settings
.idea/
.vscode/
*.swp
*.swo

# OS generated
.DS_Store
Thumbs.db

# Local database backups and session scratch (never public)
/backups/
/gh_*.json
